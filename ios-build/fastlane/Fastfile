default_platform(:ios)

# 用法（在 ios-build 目录下）：fastlane ios to_testflight
# 需要的环境变量全部由 GitHub Actions 的 Secrets 注入：
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT(p8 私钥的 base64) / IPA_PATH
platform :ios do
  lane :to_testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # 只上传到 TestFlight，不自动提交审核；审核由你在网页上手动点。
    pilot(
      api_key: api_key,
      app_identifier: "com.zhangpeizhe.kuailepeqi",
      ipa: ENV["IPA_PATH"],
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
