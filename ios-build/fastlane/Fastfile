default_platform(:ios)

# 用法（在 ios-build 目录下）：fastlane ios to_testflight
# 需要的环境变量全部由 GitHub Actions 的 Secrets 注入：
#   ASC_KEY_ID / ASC_ISSUER_ID / P8_PATH(.p8 密钥文件路径) / IPA_PATH
platform :ios do
  # 开发签名要求账号里至少有一台设备；无 Mac 的开发者账号里通常一台都没有，
  # 这里在首次构建时自动注册一台占位设备（仅让归档签名通过，TestFlight/上架用分发证书，不受影响）。
  lane :ensure_device do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["P8_PATH"],
      in_house: false
    )
    register_devices(
      api_key: api_key,
      devices: { "CI Build Placeholder" => "00008101-00C1DEADBEEFCAFE" },
      platform: "ios"
    )
  end

  lane :to_testflight do
    # 兼容两种调用方式：CI 提供 P8_PATH（密钥文件）时优先用文件；
    # 否则回退到 ASC_KEY_CONTENT（base64）。
    key_opts = if ENV["P8_PATH"] && !ENV["P8_PATH"].to_s.empty?
                 { key_filepath: ENV["P8_PATH"] }
               else
                 { key_content: ENV["ASC_KEY_CONTENT"], is_key_content_base64: true }
               end
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      **key_opts,
      in_house: false
    )

    # 只上传到 TestFlight，不自动提交审核；审核由你在网页上手动点。
    pilot(
      api_key: api_key,
      app_identifier: "com.zhangpeizhe.kuailepeqi",
      ipa: ENV["IPA_PATH"],
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
